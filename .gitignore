# workspace 공통 규약 (절대경로 심볼릭 링크 — 커밋하지 않는다)
.conventions/

# Isaac Sim USD assets are generated from the URDFs by
# cho_simulation/cho_simulation_isaac/isaac/convert_urdf_to_usd.py (see usd/README.md).
# They are large binaries and always reproducible, so they stay out of git.
cho_description/*/usd/*
!cho_description/*/usd/README.md

# cuRobo / cuMotion vendor checkouts (todo/CUROBO_MOVEIT_TODO.md, extern/VENDORED_CUROBO.md).
# Not submodules yet, and extern/curobo is a 375 MB tree that also holds the
# editable install's compiled .so files. Obtain them with the recipe in
# extern/VENDORED_CUROBO.md rather than committing them here.
/extern/curobo/
/extern/isaac_ros_cumotion/
/extern/isaac_ros_common/
/extern/nvblox_msgs_src/
