build/
install/
log/
.vscode/
*.pyc

# workspace 공통 규약 (절대경로 심볼릭 링크 — 커밋하지 않는다)
.conventions/

# Isaac Sim USD assets are generated from the URDFs by
# cho_simulation/cho_simulation_isaac/isaac/convert_urdf_to_usd.py (see usd/README.md).
# They are large binaries and always reproducible, so they stay out of git.
cho_description/*/usd/*
!cho_description/*/usd/README.md

# nvblox_msgs is a sparse checkout, not a submodule: the full isaac_ros_nvblox
# tree carries ten packages plus its own nested submodules, and nvblox_ros needs
# the nvblox CUDA library that nothing here uses. Only nvblox_msgs is wanted, and
# a submodule cannot express that. See docs/installation.md.
/extern/nvblox_msgs_src/
