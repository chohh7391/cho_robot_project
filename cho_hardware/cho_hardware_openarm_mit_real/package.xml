<?xml version="1.0"?>
<package format="3">
  <name>cho_hardware_openarm_mit_real</name>
  <version>0.1.0</version>
  <description>Commissioning-only SocketCAN MIT backend for one OpenArm V10 arm.</description>
  <maintainer email="chohh7391@gmail.com">Hyunho Cho</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>cho_openarm_mit_core</depend>
  <!-- extern/openarm_can (package.xml, build_type cmake). Declared so colcon
       builds it first: without the edge this package could be configured before
       it, find OpenArmCAN missing, and silently skip the plugin. openarm_can
       does find_package(CLI11 REQUIRED) for its command-line tools but its
       package.xml declares nothing, so the rosdep key is declared here (extern/
       is not edited). CLI11 is header-only: build time only. -->
  <depend>openarm_can</depend>
  <build_depend>cli11</build_depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>cho_description_openarm</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
