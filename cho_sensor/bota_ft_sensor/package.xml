<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bota_ft_sensor</name>
  <version>1.0.0</version>
  <description>
    Bota Systems FT sensor launch for the arms here, on top of Bota's own
    bota_driver and bota_driver_example (extern/).
  </description>
  <maintainer email="chohh7391@gmail.com">Hyunho Cho</maintainer>
  <license>Apache-2.0</license>
  <author email="chohh7391@gmail.com">Hyunho Cho</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>bota_driver</exec_depend>
  <exec_depend>bota_driver_example</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
