<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cho_oak</name>
  <version>0.1.0</version>
  <description>Bring up a Luxonis OAK-D: the stock depthai_ros_driver plus the pipeline this
  bench needs - the global-shutter mono pair published as separate streams, and the IR dot
  projector off. Camera only; detection lives in cho_object_pose. Knows nothing about the robot
  and publishes no transform between the camera and any robot link.</description>
  <maintainer email="chohh7391@gmail.com">chohh7391</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>depthai_ros_driver</exec_depend>
  <!-- The camera's own mesh and the oak_model_origin frame it is drawn at.
       The driver already pulls this in; declaring it makes the rviz display
       that names the mesh a stated dependency rather than a lucky one. -->
  <exec_depend>depthai_descriptions</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
