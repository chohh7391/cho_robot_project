<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    FAIRINO FR5 arm macro.

    Kinematics, inertials and meshes come from the vendor bundle
    (fairino5_v6_robot, SolidWorks URDF export). Joints are j1..j6 (revolute),
    the serial chain is base_link -> shoulder_link -> upperarm_link ->
    forearm_link -> wrist1_link -> wrist2_link -> wrist3_link, and a fixed
    tool_tcp sits 0.1 m past wrist3_link. The cho controllers use wrist3_link as
    the end-effector frame (ee_name); tool_tcp is kept for downstream tooling.
  -->
  <xacro:macro name="fr5_robot" params="prefix parent *origin">

    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
    </joint>

    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.00031896 -0.00029673 0.042463" rpy="0 0 0"/>
        <mass value="1.6185"/>
        <inertia ixx="0.0030836" ixy="1.5354E-05" ixz="-1.9315E-05"
                 iyy="0.0030825" iyz="-1.7918E-05" izz="0.0045209"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/base_link.STL"/>
        </geometry>
        <material name="fr5_gray">
          <color rgba="0.89804 0.91765 0.92941 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/base_link.STL"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}shoulder_link">
      <inertial>
        <origin xyz="5.0029E-07 -0.0040922 0.14629" rpy="0 0 0"/>
        <mass value="4.3771"/>
        <inertia ixx="0.010731" ixy="-8.0587E-09" ixz="-3.6773E-08"
                 iyy="0.010408" iyz="0.00012853" izz="0.0081793"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/shoulder_link.STL"/>
        </geometry>
        <material name="fr5_gray">
          <color rgba="0.89804 0.91765 0.92941 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/shoulder_link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}j1" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}shoulder_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.0543" upper="3.0543" effort="150" velocity="3.15"/>
      <dynamics damping="0" friction="0"/>
    </joint>

    <link name="${prefix}upperarm_link">
      <inertial>
        <origin xyz="-0.2125 -5.7643E-09 0.1346" rpy="0 0 0"/>
        <mass value="14.458"/>
        <inertia ixx="0.028392" ixy="-1.337E-07" ixz="-3.9895E-09"
                 iyy="0.4559" iyz="4.214E-08" izz="0.44974"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/upperarm_link.STL"/>
        </geometry>
        <material name="fr5_gray">
          <color rgba="0.89804 0.91765 0.92941 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/upperarm_link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}j2" type="revolute">
      <origin xyz="0 0 0.152" rpy="1.5708 0 0"/>
      <parent link="${prefix}shoulder_link"/>
      <child link="${prefix}upperarm_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-4.6251" upper="1.4835" effort="150" velocity="3.15"/>
      <dynamics damping="0" friction="0"/>
    </joint>

    <link name="${prefix}forearm_link">
      <inertial>
        <origin xyz="-0.18793 -8.4503E-07 0.0066357" rpy="0 0 0"/>
        <mass value="7.6737"/>
        <inertia ixx="0.0085096" ixy="2.1613E-06" ixz="-0.0068678"
                 iyy="0.16971" iyz="3.7086E-08" izz="0.16854"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/forearm_link.STL"/>
        </geometry>
        <material name="fr5_gray">
          <color rgba="0.89804 0.91765 0.92941 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/forearm_link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}j3" type="revolute">
      <origin xyz="-0.425 0 0" rpy="0 0 0"/>
      <parent link="${prefix}upperarm_link"/>
      <child link="${prefix}forearm_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.8274" upper="2.8274" effort="150" velocity="3.15"/>
      <dynamics damping="0" friction="0"/>
    </joint>

    <link name="${prefix}wrist1_link">
      <inertial>
        <origin xyz="4.98E-07 -0.003754 0.097155" rpy="0 0 0"/>
        <mass value="1.6266"/>
        <inertia ixx="0.00216" ixy="4.888E-09" ixz="3.1528E-08"
                 iyy="0.0015455" iyz="3.7678E-05" izz="0.0019902"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/wrist1_link.STL"/>
        </geometry>
        <material name="fr5_gray">
          <color rgba="0.89804 0.91765 0.92941 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/wrist1_link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}j4" type="revolute">
      <origin xyz="-0.39501 0 0" rpy="0 0 0"/>
      <parent link="${prefix}forearm_link"/>
      <child link="${prefix}wrist1_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-4.6251" upper="1.4835" effort="28" velocity="3.2"/>
      <dynamics damping="0" friction="0"/>
    </joint>

    <link name="${prefix}wrist2_link">
      <inertial>
        <origin xyz="-4.5588E-07 0.0038617 0.098257" rpy="0 0 0"/>
        <mass value="1.5812"/>
        <inertia ixx="0.0020612" ixy="8.7064E-09" ixz="-3.4742E-08"
                 iyy="0.0014477" iyz="-2.8534E-05" izz="0.0019573"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/wrist2_link.STL"/>
        </geometry>
        <material name="fr5_gray">
          <color rgba="0.89804 0.91765 0.92941 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/wrist2_link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}j5" type="revolute">
      <origin xyz="0 0 0.1021" rpy="1.5708 0 0"/>
      <parent link="${prefix}wrist1_link"/>
      <child link="${prefix}wrist2_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.0543" upper="3.0543" effort="28" velocity="3.2"/>
      <dynamics damping="0" friction="0"/>
    </joint>

    <link name="${prefix}wrist3_link">
      <inertial>
        <origin xyz="7.7496E-05 1.7751E-05 0.076122" rpy="0 0 0"/>
        <mass value="0.52542"/>
        <inertia ixx="0.00027721" ixy="-1.8677E-09" ixz="-1.188E-07"
                 iyy="0.00027839" iyz="2.2607E-07" izz="0.00041605"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/wrist3_link.STL"/>
        </geometry>
        <material name="fr5_gray">
          <color rgba="0.89804 0.91765 0.92941 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/fr5/wrist3_link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}j6" type="revolute">
      <origin xyz="0 0 0.102" rpy="-1.5708 0 0"/>
      <parent link="${prefix}wrist2_link"/>
      <child link="${prefix}wrist3_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.0543" upper="3.0543" effort="28" velocity="3.2"/>
      <dynamics damping="0" friction="0"/>
    </joint>

    <!-- Tool centre point: 0.1 m past wrist3_link along its z-axis. -->
    <link name="${prefix}tool_tcp"/>
    <joint name="${prefix}wrist3_to_tool_tcp" type="fixed">
      <parent link="${prefix}wrist3_link"/>
      <child link="${prefix}tool_tcp"/>
      <origin xyz="0 0 0.100" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

  <!--
    DH Robotics AG-95 parallel gripper, bolted straight to the tool flange.
    `parent` is tool_tcp, which IS the flange face: the wrist3_link collision
    mesh runs to z = +0.099, so the 100 mm tool_tcp offset is the length of the
    wrist, not a TCP hanging in free space.

    The gripper reaches 200.8 mm past that face and is 168 mm across, and until
    it was modelled MoveIt planned as though that volume were empty - which is
    what drove the gripper into the arm. Geometry now comes from the vendored
    upstream meshes; see the macro below and meshes/ag95/README.md.

    Both jaws move symmetrically, so one finger travels half the stroke. The
    single finger joint stands for that half; cho_controller_gripper maps it back
    to the full opening through width_at_open.
  -->
  <xacro:macro name="fr5_ag95_gripper" params="prefix parent yaw:=0">
    <!--
      One link carries the whole gripper: three collision elements on
      gripper_base_link rather than a link per part, because every extra link is
      another row in MoveIt's collision matrix and another SRDF pair to reason
      about, for no gain when the parts do not move independently.

      The two meshes are the AG-95 parts that are RIGID with respect to the
      flange, taken unmodified from the vendored upstream model (millimetres,
      hence the scale) and placed at the origin, which is where upstream's own
      base and body transforms compose to. The box covers the jaws: their swept
      volume over the entire 0-to-closed stroke, measured off the same meshes
      (see meshes/ag95/README.md). Conservative on purpose - a fixed box that
      encloses every jaw position can refuse a plan the real gripper would have
      cleared, but it can never pass one the real gripper would have hit.

      `yaw` is the rotation about the flange axis, and 0 is confirmed correct for
      this cell rather than assumed: the operator's own fr5_ag95 URDF mounts the
      gripper on a `tool0` whose net transform from wrist3_link is
      xyz (0, 0, 0.1) with an IDENTITY rotation - the same frame as tool_tcp
      here - and places the two jaw knuckles at x = -0.016 and +0.016 in it, so
      the jaws separate along x, which is the finger axis below. Keep the
      parameter anyway: bolting the gripper on a quarter turn round would
      otherwise silently rotate a 168 x 51 mm box by 90 degrees.

      Mass is the upstream figure, independently corroborated by the operator's
      own URDF at 0.83416 kg, and is carried for completeness only: the FR5 is
      position-controlled and the robot controller does its own gravity
      compensation, so the payload that matters is the one set on the teach
      pendant, not this number.

      On gripper length the two available models disagree - the operator's URDF
      puts its grasp frame at z = 170 mm and the vendored upstream one at
      190 mm - which is exactly why the jaw box is sized from the swept mesh
      envelope (200.8 mm) rather than from either grasp frame: it encloses both.
    -->
    <link name="${prefix}gripper_base_link">
      <inertial>
        <origin xyz="0 0 0.0655" rpy="0 0 0"/>
        <mass value="0.8347"/>
        <inertia ixx="0.0025" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.0008"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/ag95/visual/base_link.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="fr5_ag95_plate">
          <color rgba="0.79216 0.81961 0.93333 1"/>
        </material>
      </visual>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/ag95/visual/gripper_body.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="fr5_ag95_body">
          <color rgba="0.15 0.15 0.15 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/ag95/collision/base_link.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://cho_description_fr5/meshes/ag95/collision/gripper_body.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <!-- The jaw envelope is drawn as well as checked, translucent so it reads
           as a swept volume rather than as fingers. Seeing exactly what the
           planner collides against beats seeing prettier geometry that does
           not match it. -->
      <visual>
        <origin xyz="0 0 0.1456" rpy="0 0 0"/>
        <geometry>
          <box size="0.1682 0.0508 0.1104"/>
        </geometry>
        <material name="fr5_ag95_jaw_envelope">
          <color rgba="0.9 0.6 0.2 0.25"/>
        </material>
      </visual>
      <collision>
        <!-- Jaw sweep: x 168.2, y 50.8, z 90.4 to 200.8 mm from the flange. -->
        <origin xyz="0 0 0.1456" rpy="0 0 0"/>
        <geometry>
          <box size="0.1682 0.0508 0.1104"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}flange_to_gripper" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 ${yaw}"/>
    </joint>

    <!-- The commanded finger. Geometry-free: the jaws are already covered by the
         box above, and giving this link its own body would double-count them.
         Axis x, matching the direction the upstream linkage actually drives the
         jaws. Both jaws move, so this one joint stands for half the stroke. -->
    <link name="${prefix}gripper_finger_link"/>
    <joint name="${prefix}gripper_finger_joint" type="prismatic">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_finger_link"/>
      <origin xyz="0 0 0.1456" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <!-- Half of the 95 mm stroke: 0 closed, 0.0475 fully open. -->
      <limit lower="0.0" upper="0.0475" effort="100.0" velocity="0.15"/>
    </joint>
  </xacro:macro>
</robot>
