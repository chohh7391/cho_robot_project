<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr5">
  <!--
    Top-level FR5 description. One entry point for every backend; pick it with
    the `hardware` argument (mujoco | isaac | gazebo | mock | fairino).

    MuJoCo and Isaac bringups expand this file with xacro.process_file(...,
    mappings={'hardware': ...}); the Gazebo bringup passes hardware:=gazebo plus
    simulation_controllers:=<controllers.yaml>; the real bringup passes
    hardware:=fairino plus robot_ip:=<FR5 IP>.
  -->
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="hardware" default="mujoco"/>
  <xacro:arg name="robot_ip" default="192.168.58.2"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="initial_positions_file"
             default="$(find cho_description_fr5)/config/initial_positions.yaml"/>
  <xacro:arg name="mujoco_initial_keyframe" default=""/>
  <!-- none | ag95. The AG-95 is driven by the robot controller over RS485, so
       it is only commandable on the real (fairino) build. -->
  <xacro:arg name="gripper" default="none"/>
  <!-- RS485 gripper registration, forwarded to the hardware component so it can
       call SetGripperConfig/ActGripper. The real bringup fills these from
       cho_bringup_fr5/config/real/fr5.config.yaml; the defaults describe the
       DAHUAN gripper registered as PGI-140 on end-effector port 1. -->
  <xacro:arg name="gripper_company" default="4"/>
  <xacro:arg name="gripper_device" default="0"/>
  <xacro:arg name="gripper_softversion" default="0"/>
  <xacro:arg name="gripper_bus" default="1"/>
  <xacro:arg name="gripper_index" default="1"/>
  <xacro:arg name="gripper_speed_percent" default="30"/>
  <xacro:arg name="gripper_force_percent" default="30"/>
  <xacro:arg name="gripper_percent_at_closed" default="0"/>
  <xacro:arg name="gripper_percent_at_open" default="100"/>
  <xacro:arg name="gripper_open_on_activate" default="false"/>
  <xacro:arg name="gripper_apply_config" default="false"/>
  <xacro:arg name="gripper_required" default="false"/>

  <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>
  <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)}"/>

  <xacro:include filename="$(find cho_description_fr5)/urdf/fr5_macro.xacro"/>
  <xacro:include filename="$(find cho_description_fr5)/urdf/fr5.ros2_control.xacro"/>

  <link name="world"/>

  <xacro:fr5_robot prefix="$(arg prefix)" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:fr5_robot>

  <xacro:if value="${'$(arg gripper)' == 'ag95'}">
    <xacro:fr5_ag95_gripper prefix="$(arg prefix)" parent="$(arg prefix)tool_tcp"/>
  </xacro:if>

  <xacro:fr5_ros2_control
    name="fr5_system"
    prefix="$(arg prefix)"
    hardware="$(arg hardware)"
    robot_ip="$(arg robot_ip)"
    initial_positions="${initial_positions}"
    gripper="$(arg gripper)"
    gripper_company="$(arg gripper_company)"
    gripper_device="$(arg gripper_device)"
    gripper_softversion="$(arg gripper_softversion)"
    gripper_bus="$(arg gripper_bus)"
    gripper_index="$(arg gripper_index)"
    gripper_speed_percent="$(arg gripper_speed_percent)"
    gripper_force_percent="$(arg gripper_force_percent)"
    gripper_percent_at_closed="$(arg gripper_percent_at_closed)"
    gripper_percent_at_open="$(arg gripper_percent_at_open)"
    gripper_open_on_activate="$(arg gripper_open_on_activate)"
    gripper_apply_config="$(arg gripper_apply_config)"
    gripper_required="$(arg gripper_required)"
    mujoco_initial_keyframe="$(arg mujoco_initial_keyframe)"/>

  <!-- Gazebo (Ignition) ros2_control system plugin. -->
  <xacro:if value="${'$(arg hardware)' == 'gazebo'}">
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg simulation_controllers)</parameters>
        <controller_manager_node_name>controller_manager</controller_manager_node_name>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
