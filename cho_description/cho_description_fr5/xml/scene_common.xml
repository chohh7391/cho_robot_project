<mujoco model="fr5 scene common">
  <!-- NB this is the inverse of cho_description_franka's shape, where
       scene_torque.xml includes scene.xml and only swaps the actuators.
       There the variants differ by a top-level section; here they differ by
       the ROBOT file, so including the base scene would drag in the wrong
       robot. The shared half is factored out instead.

       Everything a scene adds around the robot: lighting, ground plane and
       view statistics. Held apart because MJCF has no conditionals, so the
       gripper variant needs a second scene file and this is the half the two
       share. Every element here is a top-level section, which is what makes
       it includable - unlike the gripper itself, which is a body nested
       inside wrist3_link and therefore cannot be spliced in from outside. -->
  <statistic center="0 0 0.4" extent="0.9"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-60" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>
</mujoco>
