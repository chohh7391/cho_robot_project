<mujoco model="fairino5_v6_robot">
  <!-- FR5 arm plus the AG-95. Keep the arm identical to fr5.xml; the guard
       test in cho_robot_config compares both scenes joint by joint. -->
  <compiler angle="radian" meshdir="assets"/>

  <option integrator="implicitfast"/>

  <default>
    <!-- Rotor inertia + a little joint damping. The bundle model has neither,
         which left the (velocity-undamped) position actuators oscillating on the
         heavy links; armature is what stabilises the discrete-time servo, matching
         the UR/Franka MuJoCo models (armature 0.1). -->
    <joint armature="0.1" damping="1.0"/>
    <!-- The bundle reuses each link's full visual mesh as its collision geom, so at
         the folded home pose adjacent links and the base self-collide and jam the
         joints (j1 could not rotate under 500+ Nm of servo torque). This model is
         for controller tracking, not contact, so geoms are visual-only. The cho
         controllers own the real joint/velocity limits. -->
    <geom contype="0" conaffinity="0"/>
  </default>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="shoulder_link" file="shoulder_link.STL"/>
    <mesh name="upperarm_link" file="upperarm_link.STL"/>
    <mesh name="forearm_link" file="forearm_link.STL"/>
    <mesh name="wrist1_link" file="wrist1_link.STL"/>
    <mesh name="wrist2_link" file="wrist2_link.STL"/>
    <mesh name="wrist3_link" file="wrist3_link.STL"/>
    <!-- The vendored AG-95 parts, reached out of meshdir because they live with
         the URDF's meshes rather than being duplicated here. Millimetre STLs,
         unlike the arm's, so they carry a scale. -->
    <mesh name="ag95_base_link" file="../../meshes/ag95/visual/base_link.stl"
          scale="0.001 0.001 0.001"/>
    <mesh name="ag95_gripper_body" file="../../meshes/ag95/visual/gripper_body.stl"
          scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <geom type="mesh" rgba="0.89804 0.91765 0.92941 1" mesh="base_link"/>
    <body name="shoulder_link">
      <inertial pos="5.0029e-07 -0.0040922 0.14629" quat="0.999588 0.0287044 7.54149e-06 -1.58789e-05" mass="4.3771" diaginertia="0.010731 0.0104154 0.00817191"/>
      <joint name="j1" pos="0 0 0" axis="0 0 1" range="-3.0543 3.0543"/>
      <geom type="mesh" rgba="0.89804 0.91765 0.92941 1" mesh="shoulder_link"/>
      <body name="upperarm_link" pos="0 0 0.152" quat="0.707105 0.707108 0 0">
        <inertial pos="-0.2125 -5.7643e-09 0.1346" quat="0.5 0.5 0.5 0.5" mass="14.458" diaginertia="0.4559 0.44974 0.028392"/>
        <joint name="j2" pos="0 0 0" axis="0 0 1" range="-4.6251 1.4835"/>
        <geom type="mesh" rgba="0.89804 0.91765 0.92941 1" mesh="upperarm_link"/>
        <body name="forearm_link" pos="-0.425 0 0">
          <inertial pos="-0.18793 -8.4503e-07 0.0066357" quat="0.510607 0.489172 0.489196 0.510568" mass="7.6737" diaginertia="0.16971 0.168834 0.00821541"/>
          <joint name="j3" pos="0 0 0" axis="0 0 1" range="-2.8274 2.8274"/>
          <geom type="mesh" rgba="0.89804 0.91765 0.92941 1" mesh="forearm_link"/>
          <body name="wrist1_link" pos="-0.39501 0 0">
            <inertial pos="4.98e-07 -0.003754 0.097155" quat="0.736149 0.676819 -6.33095e-05 7.15237e-05" mass="1.6266" diaginertia="0.00216 0.00199337 0.00154233"/>
            <joint name="j4" pos="0 0 0" axis="0 0 1" range="-4.6251 1.4835"/>
            <geom type="mesh" rgba="0.89804 0.91765 0.92941 1" mesh="wrist1_link"/>
            <body name="wrist2_link" pos="0 0 0.1021" quat="0.707105 0.707108 0 0">
              <inertial pos="-4.5588e-07 0.0038617 0.098257" quat="0.68712 0.726544 0.000128667 -0.000114125" mass="1.5812" diaginertia="0.0020612 0.00195889 0.00144611"/>
              <joint name="j5" pos="0 0 0" axis="0 0 1" range="-3.0543 3.0543"/>
              <geom type="mesh" rgba="0.89804 0.91765 0.92941 1" mesh="wrist2_link"/>
              <body name="wrist3_link" pos="0 0 0.102" quat="0.707105 -0.707108 0 0">
                <inertial pos="7.7496e-05 1.7751e-05 0.076122" quat="7.93213e-05 0.706804 0.00108234 0.707408" mass="0.52542" diaginertia="0.00041605 0.00027839 0.00027721"/>
                <joint name="j6" pos="0 0 0" axis="0 0 1" range="-3.0543 3.0543"/>
                <geom type="mesh" rgba="0.89804 0.91765 0.92941 1" mesh="wrist3_link"/>
                <site name="attachment_site" pos="0 0 0.1"/>
                <!-- AG-95 finger, KINEMATIC ONLY. One slide joint at the tool
                     point, mirroring the URDF's gripper_finger_joint: axis along
                     tool y, 0 closed to 0.0475 fully open (half of the 95 mm
                     stroke, because both jaws move). The axis matches the URDF,
                     which follows the direction the real AG-95 linkage drives
                     the jaws. It carries no geom, so it cannot grasp anything - it exists so the same
                     cho_interfaces/Gripper action that drives the real 485
                     gripper moves something here. Add finger geoms with real
                     AG-95 dimensions before expecting contact.

                     The joint is always present: MJCF has no conditionals, and
                     an unbound extra joint costs nothing (mujoco_ros2_control
                     looks up the joints ros2_control declares, not the reverse).
                     Its own armature/damping override the model default, which
                     is tuned for the heavy rotary links and would make a 50 g
                     finger unusably sluggish. -->
                <body name="gripper_base_link" pos="0 0 0.1">
                  <inertial pos="0 0 0.0655" mass="0.8347" diaginertia="0.0025 0.0025 0.0008"/>
                  <!-- Visual only, like every geom in this model. The two meshes
                       are the AG-95 parts rigid to the flange; the translucent
                       box is the jaws' swept volume, drawn deliberately as an
                       envelope rather than as fingers because that is exactly
                       what it is - and it is the same volume MoveIt checks. -->
                  <geom type="mesh" mesh="ag95_base_link" rgba="0.79 0.82 0.93 1"/>
                  <geom type="mesh" mesh="ag95_gripper_body" rgba="0.15 0.15 0.15 1"/>
                  <geom type="box" pos="0 0 0.1456" size="0.0841 0.0254 0.0552"
                        rgba="0.9 0.6 0.2 0.25"/>
                  <body name="gripper_finger_link" pos="0 0 0.1456">
                    <inertial pos="0 0 0" mass="0.05" diaginertia="1e-5 1e-5 1e-5"/>
                    <joint name="gripper_finger_joint" type="slide" pos="0 0 0"
                           axis="1 0 0" range="0 0.0475" armature="0.001" damping="0.5"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Named actuators: mujoco_ros2_control matches joints to actuators by name
         and dereferences mj_id2name(actuator), which is null for an unnamed one.
         kv adds the velocity feedback the bundle model lacked, so the position
         servo is critically-ish damped instead of ringing. -->
    <position name="j1" joint="j1" kp="3000" kv="300"/>
    <position name="j2" joint="j2" kp="3000" kv="300"/>
    <position name="j3" joint="j3" kp="3000" kv="300"/>
    <position name="j4" joint="j4" kp="1000" kv="100"/>
    <position name="j5" joint="j5" kp="1000" kv="100"/>
    <position name="j6" joint="j6" kp="1000" kv="100"/>
    <!-- 50 g plus 1 g of armature: kp 1000 keeps the gravity sag when the slide
         axis happens to be vertical near 0.5 mm, well inside the gripper
         controller's 2 mm position tolerance, and kv 15 is about critical. -->
    <position name="gripper_finger_joint" joint="gripper_finger_joint" kp="1000" kv="15"/>
  </actuator>

  <keyframe>
    <!-- The trailing value is gripper_finger_joint: keyframes are sized by nq
         and nu, so adding the finger means every key carries it. 0 is closed. -->
    <key name="zero"
         qpos="0 0 0 0 0 0 0"
         ctrl="0 0 0 0 0 0 0"/>
    <!-- Canonical planning-safe, non-singular simulation ready pose. -->
    <key name="home"
         qpos="0 -0.7853981634 -1.5707963268 0.7853981634 -1.5707963268 0 0"
         ctrl="0 -0.7853981634 -1.5707963268 0.7853981634 -1.5707963268 0 0"/>
    <key name="home1"
         qpos="0 -0.7853981634 -1.5707963268 0.7853981634 -1.5707963268 0 0"
         ctrl="0 -0.7853981634 -1.5707963268 0.7853981634 -1.5707963268 0 0"/>
  </keyframe>
</mujoco>
