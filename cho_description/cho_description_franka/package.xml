<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cho_description_franka</name>
  <version>1.5.3</version>
  <description>franka_description contains URDF files and meshes of Franka robots</description>
  <maintainer email="chohh7391@gmail.com">Hyunho Cho</maintainer>
  <license>Apache-2.0</license>
  <!-- The Bota SensONE mounting mesh (meshes/accessories/ft_sensor/, and its copy in
       xml/fr3_with_ft_sensor/assets/); see NOTICE. -->
  <license file="meshes/accessories/ft_sensor/LICENSE">BSD-3-Clause with Attribution Requirement (Bota Systems AG)</license>
  <author>Franka Robotics GmbH</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <exec_depend>xacro</exec_depend>
  <!-- The upstream variants under robots/ (fer, fp3, fr3v2, fr3_duo, tmrv0_2, ...)
       include files with $(find franka_description); fr3, which the bringups use, does not. -->
  <exec_depend>franka_description</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>transmission_interface</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}"/>
  </export>
</package>
