<!-- Velocity control: used when control_mode:=velocity.

     Actuator names deliberately match the ros2_control joint names.
     MujocoSystemInterface::get_actuator_id() resolves a joint first
     (mjTRN_JOINT + actuator_trnid), and only falls back to matching the
     actuator's own name. The finger actuators drive the "split_*" tendons, not
     joints, so they are *only* reachable through that fallback - rename one and
     that gripper silently becomes a passive joint.

     ctrlrange follows the URDF effort limits (40/40/27/27/7/7/7 Nm), not the
     upstream motor classes' forcerange, for the same reason the single-arm model
     does: the class default clips shoulder torque below what gravity
     compensation needs on an extended arm. -->
<mujoco model="openarm v1.0 bimanual actuators (velocity)">
  <actuator>
    <velocity class="motor_DM8009" name="openarm_left_joint1" joint="openarm_left_joint1" kv="40" forcerange="-40 40"/>
    <velocity class="motor_DM8009" name="openarm_left_joint2" joint="openarm_left_joint2" kv="40" forcerange="-40 40"/>
    <velocity class="motor_DM4340" name="openarm_left_joint3" joint="openarm_left_joint3" kv="25" forcerange="-27 27"/>
    <velocity class="motor_DM4340" name="openarm_left_joint4" joint="openarm_left_joint4" kv="25" forcerange="-27 27"/>
    <velocity class="motor_DM4310" name="openarm_left_joint5" joint="openarm_left_joint5" kv="8" forcerange="-7 7"/>
    <velocity class="motor_DM4310" name="openarm_left_joint6" joint="openarm_left_joint6" kv="8" forcerange="-7 7"/>
    <velocity class="motor_DM4310" name="openarm_left_joint7" joint="openarm_left_joint7" kv="8" forcerange="-7 7"/>
    <velocity class="motor_DM8009" name="openarm_right_joint1" joint="openarm_right_joint1" kv="40" forcerange="-40 40"/>
    <velocity class="motor_DM8009" name="openarm_right_joint2" joint="openarm_right_joint2" kv="40" forcerange="-40 40"/>
    <velocity class="motor_DM4340" name="openarm_right_joint3" joint="openarm_right_joint3" kv="25" forcerange="-27 27"/>
    <velocity class="motor_DM4340" name="openarm_right_joint4" joint="openarm_right_joint4" kv="25" forcerange="-27 27"/>
    <velocity class="motor_DM4310" name="openarm_right_joint5" joint="openarm_right_joint5" kv="8" forcerange="-7 7"/>
    <velocity class="motor_DM4310" name="openarm_right_joint6" joint="openarm_right_joint6" kv="8" forcerange="-7 7"/>
    <velocity class="motor_DM4310" name="openarm_right_joint7" joint="openarm_right_joint7" kv="8" forcerange="-7 7"/>
    <position class="motor_finger" name="openarm_left_finger_joint1" tendon="split_left" kp="300" kv="30" ctrlrange="0 0.044"/>
    <position class="motor_finger" name="openarm_right_finger_joint1" tendon="split_right" kp="300" kv="30" ctrlrange="0 0.044"/>
  </actuator>
</mujoco>
