<!-- Position control: used when control_mode:=position. 
     Actuator names deliberately match the ros2_control joint names.
     MujocoSystemInterface::get_actuator_id() resolves a joint first
     (mjTRN_JOINT + actuator_trnid), and only falls back to matching the
     actuator's own name. The finger actuator drives the "split" tendon, not a
     joint, so it is *only* reachable through that fallback - rename it and the
     gripper silently becomes a passive joint. Same trick as fr3.
-->
<mujoco model="openarm v1.0 actuators (position)">
  <actuator>
    <position class="motor" name="openarm_joint1" joint="openarm_joint1" kp="800" kv="40" forcerange="-40 40"/>
    <position class="motor" name="openarm_joint2" joint="openarm_joint2" kp="800" kv="40" forcerange="-40 40"/>
    <position class="motor" name="openarm_joint3" joint="openarm_joint3" kp="500" kv="25" forcerange="-27 27"/>
    <position class="motor" name="openarm_joint4" joint="openarm_joint4" kp="500" kv="25" forcerange="-27 27"/>
    <position class="motor" name="openarm_joint5" joint="openarm_joint5" kp="120" kv="8"  forcerange="-7 7"/>
    <position class="motor" name="openarm_joint6" joint="openarm_joint6" kp="120" kv="8"  forcerange="-7 7"/>
    <position class="motor" name="openarm_joint7" joint="openarm_joint7" kp="120" kv="8"  forcerange="-7 7"/>
    <position class="motor" name="openarm_finger_joint1" tendon="split" kp="300" kv="30" ctrlrange="0 0.044"/>
  </actuator>
</mujoco>
