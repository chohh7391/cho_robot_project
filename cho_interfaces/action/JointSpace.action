# Point-to-point joint goal (see CONTRACT.md).
#
# target_joints.position: one per joint the controller drives. With
# target_joints.name empty they are read in the controller's joint order; with
# names they are matched by name, and a goal naming an unknown joint, a joint
# twice, or not every joint is rejected.
sensor_msgs/JointState target_joints
# The motion takes at least this long [s]; longer if the joint limits require.
float64 duration_sec
---
# Define the result
bool is_completed
# Empty on success. On failure this carries the reason the goal did not
# complete, so operator clients can print it instead of a bare failure.
string message
---
# Define a feedback message
float32 percent_complete
