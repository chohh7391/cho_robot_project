# The core this project builds on, imported into the core workspace
# (README.md, The workspaces):
#
#   vcs import --recursive src < project.repos
#
# version is a core tag, the core the project's tests passed on. A branch
# follows its tip, so the project would build on whatever main is that day.
# The url is https, so a clone needs no GitHub SSH key.
repositories:
  cho_robot_project:
    type: git
    url: https://github.com/chohh7391/cho_robot_project.git
    version: v0.1.0
