<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cho_task_manager</name>
  <version>0.0.0</version>
  <description>Behavior-tree task manager for Cho robot controllers</description>
  <maintainer email="chohh7391@gmail.com">Hyunho Cho</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>py_trees</depend>
  <depend>py_trees_ros</depend>
  <depend>cho_interfaces</depend>
  <depend>cho_robot_config</depend>
  <!-- Launch-only: run_task_manager.launch.py starts it when a task passes
       object_pose_config. Nothing in this package imports it. -->
  <exec_depend>cho_object_pose</exec_depend>
  <!-- trajectory_replay reads each robot's joint VELOCITY ceiling from its
       MoveIt package's joint limits, through
       cho_robot_config.motion_limit_parameters(). Those limits, and not the
       scaling factor, are where the trajectory path is bounded:
       joint_trajectory_controller has no per-cycle clamp of its own, so a
       replay with no ceiling to check against has none at all. -->
  <exec_depend>cho_moveit_franka</exec_depend>
  <exec_depend>cho_moveit_fr5</exec_depend>
  <exec_depend>cho_moveit_openarm</exec_depend>
  <exec_depend>cho_moveit_ur</exec_depend>
  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <!-- run_task_manager.launch.py -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Reads /robot_description (utils/robot_description.py): SafetyMonitorBehavior's
       kinematic guards and trajectory_replay's joint position limits. Imported
       lazily, so a tree that uses neither never loads it; the rosdep key is in
       install_dependencies.bash SKIP_KEYS because libfranka and Pinocchio are
       pinned together as an ABI pair. -->
  <exec_depend>pinocchio</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- test_goal_frames expands every bringup's robot description to prove the
       registry's TaskSpace goal frames are root frames the controllers accept,
       and reads the UR real description's mappings out of ur_robot_driver's
       ur_control.launch.py. A missing one FAILS that test rather than skipping
       it; CHO_GOAL_FRAMES_ALLOW_MISSING=1 makes it skip instead. The bringups
       themselves and their launch goldens are read from the source tree, so
       they are not dependencies. -->
  <test_depend>xacro</test_depend>
  <test_depend>pinocchio</test_depend>
  <test_depend>ur_robot_driver</test_depend>
  <test_depend>cho_description_franka</test_depend>
  <test_depend>cho_description_fr5</test_depend>
  <test_depend>cho_description_ur</test_depend>
  <test_depend>cho_description_openarm</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
