<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cho_task_manager</name>
  <version>0.0.0</version>
  <description>Behavior-tree task manager for Cho robot controllers</description>
  <maintainer email="chohh7391@gmail.com">Hyunho Cho</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>py_trees</depend>
  <depend>py_trees_ros</depend>
  <depend>cho_interfaces</depend>
  <depend>cho_robot_config</depend>
  <!-- Launch-only: run_task_manager.launch.py starts it when a task passes
       object_pose_config. Nothing in this package imports it. -->
  <exec_depend>cho_object_pose</exec_depend>
  <!-- trajectory_replay reads this robot's joint VELOCITY ceiling from
       cho_moveit_fr5/config/joint_limits.yaml. That file, and not the
       scaling factor, is where the trajectory path is bounded:
       joint_trajectory_controller has no per-cycle clamp of its own, so a
       replay with no ceiling to check against has none at all. It is a
       config-only package, so this costs a share directory. -->
  <exec_depend>cho_moveit_fr5</exec_depend>
  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <!-- run_task_manager.launch.py -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Reads /robot_description (utils/robot_description.py): SafetyMonitorBehavior's
       kinematic guards and the FR5 replay's joint position limits. Imported
       lazily, so a tree that uses neither never loads it; the rosdep key is in
       install_dependencies.bash SKIP_KEYS because libfranka and Pinocchio are
       pinned together as an ABI pair. -->
  <exec_depend>pinocchio</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- test_goal_frames expands every bringup's robot description to prove the
       registry's TaskSpace goal frames are root frames the controllers accept.
       Skipped where they are not installed. -->
  <test_depend>xacro</test_depend>
  <test_depend>cho_description_franka</test_depend>
  <test_depend>cho_description_fr5</test_depend>
  <test_depend>cho_description_ur</test_depend>
  <test_depend>cho_description_openarm</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
