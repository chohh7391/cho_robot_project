Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1
        - /Detections1
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 10
      Color: 160; 160; 164
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.1
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Update Interval: 0
      Frame Timeout: 5
    - Class: rviz_default_plugins/Image
      Name: Detections
      Enabled: true
      Max Intensity: 4096
      Min Intensity: 0
      Normalize Range: true
      Value: true
      Topic:
        Value: /image_tags
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Raw infra1
      Enabled: false
      Max Intensity: 4096
      Min Intensity: 0
      Normalize Range: true
      Value: true
      Topic:
        Value: /camera/camera/infra1/image_rect_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 1.2
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0
      Pitch: 0.4
      Yaw: 3.6
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: ""
