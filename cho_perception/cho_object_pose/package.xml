<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cho_object_pose</name>
  <version>0.1.0</version>
  <description>Turn AprilTag detections into a grasp pose in the robot's base frame.
  Subscribes to apriltag_ros detections for decode quality, asks TF for base &lt;- tag_&lt;id&gt;,
  gates the estimate on repeatability, and publishes a PoseStamped that cho_task_manager's
  PoseTargetBehavior can latch. Knows nothing about where the camera is mounted.</description>
  <maintainer email="chohh7391@gmail.com">chohh7391</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>apriltag_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cho_robot_config</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
