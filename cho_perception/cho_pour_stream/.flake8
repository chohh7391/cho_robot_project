# flake8 rules for `colcon test` (test/test_flake8.py passes this file to
# ament_flake8) and for a plain `flake8` run here.
#
# ament_flake8's defaults (99 columns), with the rules of the optional flake8
# plugins pinned off so the verdict does not depend on which plugins a machine
# has: a ROS 2 development machine has python3-flake8-{blind-except,builtins,
# class-newline,comprehensions,deprecated,docstrings,import-order,quotes}, and
# this code was written to pycodestyle + pyflakes only. A builtins, B90
# blind-except, C4 comprehensions, C81 commas, CNL class-newline, D docstrings
# and deprecated (pep257 runs as its own test), I import-order, Q quotes.
[flake8]
extend-ignore = A,B90,C4,C81,CNL,D,I,Q
max-line-length = 99
