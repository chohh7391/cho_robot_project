<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cho_controller_chain</name>
  <version>0.1.0</version>
  <description>
    Prototype of ros2_control controller chaining: one robot-independent,
    chainable joint impedance law on the robot description's Pinocchio model,
    and the JointSpace and TaskSpace reference generators that write its
    reference interfaces.
  </description>
  <maintainer email="chohh7391@gmail.com">Hyunho Cho</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>cho_controller_base</depend>
  <depend>cho_controller_common</depend>
  <depend>cho_interfaces</depend>
  <depend>control_msgs</depend>
  <depend>controller_interface</depend>
  <depend>eigen</depend>
  <depend>generate_parameter_library</depend>
  <depend>hardware_interface</depend>
  <!-- cho_controller_common/trajectory/motion_limits_params.hpp, compiled here. -->
  <depend>joint_limits</depend>
  <depend>pinocchio</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_index_cpp</test_depend>
  <!-- The tests run on the FR3 model; the harness tests drive a
       controller_manager over mock_components (hardware_interface). -->
  <test_depend>cho_description_franka</test_depend>
  <test_depend>controller_manager</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
