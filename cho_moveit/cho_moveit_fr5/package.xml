  <version>0.1.0</version>
  <description>MoveIt 2 planning configuration for the FAIRINO FR5 robot.</description>
  <maintainer email="maintainer@example.com">cho_robot_project maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cho_description_fr5</exec_depend>
  <exec_depend>cho_interfaces</exec_depend>
  <exec_depend>cho_robot_config</exec_depend>
