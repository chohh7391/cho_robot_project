<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cho_bringup_fr5</name>
  <version>0.1.0</version>
  <description>Cho FR5 bringup wrappers for MuJoCo, Gazebo, Isaac Sim and the real FAIRINO FR5.</description>
  <maintainer email="chohh7391@gmail.com">Hyunho Cho</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>cho_bringup_isaac</exec_depend>
  <exec_depend>cho_controller_fr5</exec_depend>
  <exec_depend>cho_description_fr5</exec_depend>
  <exec_depend>cho_moveit_fr5</exec_depend>
  <exec_depend>cho_robot_config</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
