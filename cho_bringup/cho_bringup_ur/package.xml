  <version>0.1.0</version>
  <description>Cho UR bringup wrappers for simulation and real Universal Robots hardware.</description>
  <maintainer email="chohh7391@gmail.com">Hyunho Cho</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>cho_bringup_isaac</exec_depend>
  <exec_depend>mujoco_ros2_control</exec_depend>
  <exec_depend>topic_based_ros2_control</exec_depend>
  <exec_depend>cho_description_ur</exec_depend>
  <exec_depend>cho_controller_ur</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
